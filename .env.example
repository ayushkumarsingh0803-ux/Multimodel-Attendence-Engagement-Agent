# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ── Engagement Thresholds (optional) ──────────────────────────────────────────
ENGAGEMENT_THRESHOLD=60.0
PRESENCE_THRESHOLD=0.65

# ── Multimodal Fusion Weights (optional) ──────────────────────────────────────
VISUAL_WEIGHT=0.6
AUDIO_WEIGHT=0.4
